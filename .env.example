# Signal — environment template.
# Copy the backend block to backend/.env and the frontend block to
# frontend/.env.local, then fill in the values. Both files are git-ignored.
# This template must never contain a real secret.

# =============================================================== backend/.env =

# PostgreSQL connection string.
#   Local Docker (docker compose up -d db):
#     postgresql://signal:signal@localhost:5432/signal
#   Supabase, direct connection (port 5432) — recommended, keeps the asyncpg
#   statement cache working:
#     postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
#   Supabase, pooler (port 6543) — pgbouncer runs in transaction mode, so you
#   MUST also set DB_STATEMENT_CACHE_SIZE=0 below.
DATABASE_URL=

# Set to 0 only when connecting through the Supabase pooler on port 6543.
DB_STATEMENT_CACHE_SIZE=100

# Anthropic API key. Backend only — never expose this to the frontend.
# The app starts and serves the board without it; only AI analysis needs it.
ANTHROPIC_API_KEY=

LLM_MODEL=claude-sonnet-5-5
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=1

APP_ENV=local
CORS_ORIGINS=http://localhost:3000

# ======================================================== frontend/.env.local =

# Public by design: this is the backend base URL the browser calls.
# No secret may ever be placed in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
